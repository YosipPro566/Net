@model AgriculturalWebsite.Models.SearchViewModel

<div class="container mt-4">
    <h2>Результати за запитом: "@Model.Query"</h2>
    <hr />

    @if (!Model.Tractors.Any() && !Model.Products.Any() && !Model.Trailers.Any())
    {
        <div class="alert alert-info">На жаль, нічого не знайдено.</div>
    }

    @if (Model.Tractors.Any()) {
        <h3>🚜 Трактори</h3>
        <div class="row mb-4">
            @foreach (var item in Model.Tractors) {
                <div class="col-md-3 mb-3">
                    <div class="card h-100">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name">
                        <div class="card-body">
                            <h5 class="card-title">@item.Brand @item.Name</h5>
                            <p class="card-text">@item.Price грн</p>
                            <a asp-controller="Tractors" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Деталі</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Trailers.Any()) {
        <h3>🏗️ Причепи</h3>
        <div class="row mb-4">
            @foreach (var item in Model.Trailers) {
                <div class="col-md-3 mb-3">
                    <div class="card h-100">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">Вантажопідйомність: @item.Capacity кг</p>
                            <p class="card-text">@item.Price грн</p>
                            <a asp-controller="Trailers" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Деталі</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Products.Any()) {
        <h3>🌽 Продукти</h3>
        <div class="row mb-4">
            @foreach (var item in Model.Products) {
                <div class="col-md-3 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">@item.Price @item.Unit</p>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Деталі</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>