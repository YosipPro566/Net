@{
    ViewData["Title"] = "Контакти";
}

<div class="container">
    <h1 class="display-4">Зв'яжіться з нами</h1>

    <div class="row mt-4">
        <div class="col-md-6">
            <h3>Контактна інформація</h3>
            <p><strong>Адреса:</strong> м. Київ, вул. Аграрна, буд. 10</p>
            <p><strong>Телефон:</strong> +380 (44) 123-45-67</p>
            <p><strong>Email:</strong> info@agricultural.com</p>
            <p><strong>Режим роботи:</strong> Пн-Пт: 9:00 - 18:00</p>
        </div>

        <div class="col-md-6">
            <h3>Форма зворотного зв'язку</h3>
            <form method="post" asp-action="Contact">
                <div class="mb-3">
                    <label for="name" class="form-label">Ваше ім'я</label>
                    <input type="text" class="form-control" id="name" name="name" required>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>

                <div class="mb-3">
                    <label for="message" class="form-label">Повідомлення</label>
                    <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Відправити</button>
            </form>
        </div>
    </div>
</div>
