@model AgriculturalWebsite.Models.SearchViewModel

<div class="container mt-4">
    <h2 class="mb-4">❤️ Моє вибране</h2>

    @if (!Model.Tractors.Any() && !Model.Trailers.Any() && !Model.Products.Any())
    {
        <div class="alert alert-info">Ви ще нічого не додали у вибране.</div>
    }

    <div class="row">
        @foreach (var item in Model.Tractors) {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" style="height: 150px; object-fit: cover;">
                    <div class="card-body">
                        <h6 class="card-title">@item.Brand @item.Name</h6>
                        <p class="text-muted small">@item.Price.ToString("C")</p>
                        <div class="d-flex gap-2">
                            <a asp-controller="Tractors" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Деталі</a>
                            <button class="btn btn-sm btn-outline-danger" onclick="toggleFav(@item.Id, 'Tractor')">Видалити</button>
                        </div>
                    </div>
                </div>
            </div>
        }
        @foreach (var item in Model.Trailers) {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">@item.Name</h6>
                        <p class="text-muted small">@item.Price.ToString("C")</p>
                        <button class="btn btn-sm btn-outline-danger" onclick="toggleFav(@item.Id, 'Trailer')">Видалити</button>
                    </div>
                </div>
            </div>
        }
        @foreach (var item in Model.Products) {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">@item.Name</h6>
                        <p class="text-muted small">@item.Price @item.Unit</p>
                        <button class="btn btn-sm btn-outline-danger" onclick="toggleFav(@item.Id, 'Product')">Видалити</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleFav(id, type) {
            $.post('/Home/ToggleFavorite', { itemId: id, itemType: type })
                .done(function() { location.reload(); })
                .fail(function() { alert("Помилка видалення!"); });
        }
    </script>
}