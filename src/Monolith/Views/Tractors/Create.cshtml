@model AgriculturalWebsite.Models.Tractor

@{
    ViewData["Title"] = "Додати новий трактор";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white p-3">
                    <h3 class="mb-0">🚜 Додати новий трактор у каталог</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold">Назва оголошення</label>
                                <input asp-for="Name" class="form-control" placeholder="Наприклад: Трактор МТЗ-82" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Brand" class="form-label fw-bold">Бренд / Виробник</label>
                                <input asp-for="Brand" class="form-control" placeholder="Наприклад: John Deere" required />
                                <span asp-validation-for="Brand" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Model" class="form-label fw-bold">Модель</label>
                                <input asp-for="Model" class="form-control" placeholder="Наприклад: 5075E" required />
                                <span asp-validation-for="Model" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Power" class="form-label fw-bold">Потужність (к.с.)</label>
                                <input asp-for="Power" class="form-control" type="number" placeholder="Наприклад: 75" required />
                                <span asp-validation-for="Power" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold">Ціна (₴)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₴</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ImageUrl" class="form-label fw-bold">Посилання на зображення (URL)</label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Детальний опис техніки</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Опишіть технічний стан, комплектацію, умови доставки..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                ⬅ Назад до списку
                            </a>
                            <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm">
                                💾 Зберегти та опублікувати
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}